# Để trống = proxy qua Next.js (/api → :8080)
NEXT_PUBLIC_API_URL=

# Backend API (rewrite target)
API_BACKEND_URL=http://127.0.0.1:8080

# Mật khẩu truy cập dashboard — PHẢI trùng DASHBOARD_PASSWORD trong .env gốc
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-strong-password
DASHBOARD_AUTH_SALT=cps-bot-dashboard
