# Sao chép file này thành .env rồi điền thông tin thật
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
GROUP_CHAT_ID=-1001234567890
CPS_PROVINCE_ID=30
# GraphQL CPS (url → product_id → chi tiết) — dùng production để có giá S-Member + KM
CPS_GRAPHQL_URL_ENDPOINT=https://api.cellphones.com.vn/graphql-url/graphql/query
CPS_GRAPHQL_V2_ENDPOINT=https://api.cellphones.com.vn/v2/graphql/query
CPS_GRAPHQL_SEARCH_ENDPOINT=https://api.cellphones.com.vn/graphql-search/v2/graphql/query
# Tồn theo cửa hàng (shops_stock) — graphql-dashboard
CPS_GRAPHQL_DASHBOARD_ENDPOINT=https://api.cellphones.com.vn/graphql-dashboard/graphql/query
# Reviews — graphql-customer
CPS_GRAPHQL_CUSTOMER_ENDPOINT=https://api.cellphones.com.vn/graphql-customer/graphql/query
# Main menu (id=5) → category_id map — throttle url_info + sync 0h/ngày
CPS_MAIN_MENU_ID=5
MENU_CATEGORY_FETCH_DELAY_SEC=3
MENU_CATEGORY_MAP_PATH=data/menu_category_map.json
CATEGORY_ATTRIBUTES_MAP_PATH=data/category_attributes_map.json
CATEGORY_ATTRIBUTES_FETCH_DELAY_SEC=3
# Dashboard ops (metrics.log + sessions.db)
METRICS_LOG_PATH=metrics.log
# Feedback training — admin duyệt → few-shot LLM
FEEDBACK_TRAINING_PATH=data/feedback_training.jsonl
FEEDBACK_TRAINING_ENABLED=1
FEEDBACK_TRAINING_MAX_EXAMPLES=6
# Product map — tra product_id trước GraphQL search
PRODUCT_MAP_PATH=data/product_map.map
PRODUCT_MAP_ENABLED=1
PRODUCT_MAP_MIN_SCORE=25
PRODUCT_MAP_MIN_CONFIDENCE=0.6
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Bảo vệ dashboard — bắt buộc khi public internet (user: admin)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-strong-password
DASHBOARD_AUTH_SALT=cps-bot-dashboard

# Tuỳ chọn — ngrok authtoken (hoặc chạy: ngrok config add-authtoken <token>)
# NGROK_AUTHTOKEN=your-ngrok-authtoken-here
# Next.js dashboard (bot-dashboard/)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
# Session persistence (SQLite) — giữ ngữ cảnh qua restart
SESSION_PERSISTENCE=1
SESSION_DB_PATH=sessions.db
# Thời gian giữ ngữ cảnh mỗi session (giờ) — mặc định 24h
SESSION_TTL_HOURS=24
# Cache tên user Lark/Telegram cho dashboard (gom nhóm Messages)
USER_NAMES_CACHE_PATH=var/user_names.json
# Link sản phẩm hiển thị cho user (url_path ghép với domain này)
CPS_WEB_BASE_URL=https://cellphones.com.vn
# Trả góp — payment-installment + guest token SSO
CPS_API_BASE_URL=https://api.cellphones.com.vn
CPS_PAYMENT_VER=v3
CPS_SSO_GUEST_TOKEN_URL=https://api.smember.com.vn/sso/v1/auth/guest-token
# SerpAPI — mặc định tắt; bot ưu tiên CPS quick_search + advanced_search
SERPAPI_ENABLED=0
SERPAPI_API_KEY=
SERPAPI_ENDPOINT=https://serpapi.com/search.json
# 0 = Serp fail thì không fallback quick_search, tránh trả sai sản phẩm
# 1 = cho phép fallback quick_search
SERPAPI_FALLBACK_TO_CPS_SEARCH=0
# LLM provider: gemini | deepseek | byteplus
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
# Latency: browse list (category filter / budget) trả template, không LLM (~2-3s)
FAST_BROWSE_REPLY=1
SLIM_LLM_PAYLOAD=1
LLM_MAX_SEARCH_RESULTS=5
# LLM phân loại intent (chặn câu ngoài CellphoneS) + chuẩn hóa từ khóa đồng nghĩa
LLM_INTENT_CLASSIFY=1
LLM_KEYWORD_NORMALIZE=1
LLM_QUERY_ROUTER=1
# DeepSeek (khi LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# BytePlus ModelArk (khi LLM_PROVIDER=byteplus)
# modelark = API thường (/api/v3) | coding = Coding Plan (/api/coding/v3)
# Coding Plan quick start: https://docs.byteplus.com/en/docs/ModelArk/1928261
BYTEPLUS_API_MODE=modelark
BYTEPLUS_API_KEY=
# modelark: gpt-oss-120b-250805 | seed-2-0-pro-* | hoặc BYTEPLUS_ENDPOINT_ID=ep-xxx
# coding: ark-code-latest | kimi-k2.5 | glm-4.7 (base /api/coding/v3)
BYTEPLUS_MODEL=
BYTEPLUS_ENDPOINT_ID=
BYTEPLUS_BASE_URL=

# Lark Bot (python lark_bot.py)
LARK_APP_ID=cli_xxxxxxxxxx
LARK_APP_SECRET=your_lark_app_secret_here
# Để trống = bot trả lời mọi chat; gõ /chatid trong Lark để lấy ID
LARK_CHAT_ID=
# lark = Lark quốc tế | feishu = Feishu Trung Quốc
LARK_API_DOMAIN=lark
# 1 = trong topic đã @bot, trả lời tin tiếp không cần @
# BẮT BUỘC bật quyền Lark: im:message.group_msg (hoặc group_msg:readonly)
# Chỉ có im:message.group_at_msg thì Lark KHÔNG gửi event tin không @
LARK_THREAD_AUTO_REPLY=1
# Tên bot khi @ trên Lark (phân cách dấu phẩy) — vd: CPS Bot,Gemini Bot
LARK_BOT_MENTION_NAMES=
# Lark Base — lưu feedback nút 👍/👎 (Share Base cho bot app, scope bitable:app)
LARK_BITABLE_ENABLED=1
LARK_BITABLE_APP_TOKEN=AppTokenXXXXXX
LARK_BITABLE_TABLE_ID=tblYYYYYY
# Option single-select trong Base — phải khớp tên option
LARK_BITABLE_CATEGORY=Bot tư vấn
LARK_BITABLE_STATUS=Mới
# Tên cột URL trong Base — link tới topic hội thoại feedback
LARK_BITABLE_COL_TOPIC_LINK=Link topic
# text = cột Text | url = cột Hyperlink (Link topic thường là url)
LARK_BITABLE_TOPIC_LINK_FORMAT=url
# Group admin nhận thông báo feedback mới (chat_id dạng oc_...)
LARK_FEEDBACK_NOTIFY_CHAT_ID=oc_607bfcc50091b7450910246d55322707

# --- Docker Compose (docker compose up) ---
# DASHBOARD_UI_PORT=3000
# Chạy: docker compose up -d
# UI:   docker compose --profile ui up -d
# Bot:  docker compose --profile bots up -d