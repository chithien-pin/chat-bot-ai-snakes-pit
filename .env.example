# Sao chép file này thành .env rồi điền thông tin thật
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
GROUP_CHAT_ID=-1001234567890
CPS_PROVINCE_ID=30
# GraphQL CPS (url → product_id → chi tiết)
CPS_GRAPHQL_URL_ENDPOINT=https://api-stag.cps.onl/graphql-url/graphql/query
CPS_GRAPHQL_V2_ENDPOINT=https://api-stag.cps.onl/v2/graphql/query
# Ưu tiên flash miễn phí; bot tự thử model dự phòng nếu lỗi
GEMINI_MODEL=gemini-2.5-flash

# Lark Bot (python lark_bot.py)
LARK_APP_ID=cli_xxxxxxxxxx
LARK_APP_SECRET=your_lark_app_secret_here
# Để trống = bot trả lời mọi chat; gõ /chatid trong Lark để lấy ID
LARK_CHAT_ID=
# lark = Lark quốc tế | feishu = Feishu Trung Quốc
LARK_API_DOMAIN=lark
